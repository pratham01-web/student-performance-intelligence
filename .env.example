# Environment Configuration Template
# Copy to .env and adjust variables as required for local development.

# Application Environment (development, testing, production)
ENVIRONMENT=development

# Backend API Configuration
API_BASE_URL=http://localhost:8000
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Database Configuration (Phase 02 baseline)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=student_intelligence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
